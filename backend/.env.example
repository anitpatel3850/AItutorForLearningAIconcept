# =========================================================================
# AI Quest - Real AI Tutor & Game Engine Backend Environment Configuration
# =========================================================================

# MongoDB Atlas or Local MongoDB Connection
# For MongoDB Atlas in Production / Render:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# For Local Development:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=ai_quest

# Google Gemini API or OpenAI API Key
# (AI Tutor utilizes Gemini 3.5 Flash Lite)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
SECRET_KEY=replace-with-a-secure-secret-key-in-production
